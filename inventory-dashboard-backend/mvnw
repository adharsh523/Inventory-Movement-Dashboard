# Maven Wrapper startup batch script

MAVEN_PROJECTBASEDIR="${MAVEN_BASEDIR:-"$(pwd)"}"
MAVEN_WRAPPER_PROPERTIES="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties"

if [ -r "$MAVEN_WRAPPER_PROPERTIES" ]; then
    DISTRIBUTION_URL=$(grep "^distributionUrl" "$MAVEN_WRAPPER_PROPERTIES" | tail -n 1 | cut -d= -f2)
fi

# Try to use system mvn if available
if command -v mvn &>/dev/null; then
    exec mvn "$@"
fi

echo "Maven not found. Please install Maven 3.8+ or run: sudo apt install maven"
exit 1
